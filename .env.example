# Пример переменных окружения для сборки.
#
# Локальная сборка с боевыми значениями:
#   set -a && . ./.env && set +a && python3 tools/build.py
#
# На GitHub значения задаются в
#   Settings → Secrets and variables → Actions → Secrets → New repository secret
# и подставляются workflow'ом .github/workflows/deploy.yml.
#
# Файл .env в репозиторий не коммитится (см. .gitignore).

# Адрес, по которому сайт доступен. Влияет на canonical, og:url и sitemap.xml.
# В GitHub Actions вычисляется автоматически; переопределить можно
# переменной SITE_URL (Settings → Secrets and variables → Actions → Variables).
SITE_URL=https://dirigible.community

# Яндекс.Метрика — номер счётчика (только цифры)
YANDEX_METRIKA_ID=

# Top.Mail.Ru — номер счётчика (только цифры)
TOP_MAIL_RU_ID=

# Виджет пожертвований donation.ru: идентификатор загрузчика (UUID из ссылки
# https://widgets.donation.ru/wloader/<ЭТОТ-UUID>/wloader.js)
DONATION_WIDGET_ID=

# Идентификатор конкретной платёжной формы (UUID). Без него виджет не найдёт
# точку монтирования <mixplat-form> и форма не отрисуется.
DONATION_FORM_ID=

# Отдельные формы под адресные сборы. Если не заданы — используется общая
# форма выше, и пожертвование уходит в общий проект БЕЗ привязки к адресату.
# Чтобы сборы стали действительно адресными, нужно завести отдельные формы
# (или включить поле «Назначение» в кабинете donation.ru) и указать их id.
DONATION_FORM_ID_VANYA=
DONATION_FORM_ID_BROTHERS=
